			}
    },
    "mfe-shared": {
      "projectType": "library",
      "root": "projects/mfe-shared",
      "sourceRoot": "projects/mfe-shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/mfe-shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/mfe-shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/mfe-shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/mfe-shared/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "mfe-shared-ui-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/mfe-shared-ui-demo",
      "sourceRoot": "projects/mfe-shared-ui-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/mfe-shared-ui-demo",
            "index": "projects/mfe-shared-ui-demo/src/index.html",
            "browser": "projects/mfe-shared-ui-demo/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/mfe-shared-ui-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mfe-shared-ui-demo/public"
              }
            ],
            "styles": [
              "projects/mfe-shared-ui-demo/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mfe-shared-ui-demo:build:production"
            },
            "development": {
              "buildTarget": "mfe-shared-ui-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/mfe-shared-ui-demo/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mfe-shared-ui-demo/public"
              }
            ],
            "styles": [
              "projects/mfe-shared-ui-demo/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
	},
	"cli": {
		"analytics": false
	}
}